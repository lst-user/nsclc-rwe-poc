# Anthropic — leave unset if you've run `ant auth login`; the SDK picks up
# that profile automatically. Set this only if you need a specific API key.
ANTHROPIC_API_KEY=

# Hosted Postgres instance (OMOP CDM database). Include sslmode=require
# unless your provider terminates TLS differently.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# OHDSI Atlas WebAPI (public demo instance)
ATLAS_BASE_URL=https://atlas-demo.ohdsi.org/WebAPI
ATLAS_SOURCE_KEY=SYNPUF1K
